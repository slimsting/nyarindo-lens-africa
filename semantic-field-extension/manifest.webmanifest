{
  "id": "/semantic-field-extension/",
  "name": "Semantic Field — Nyarindo Lens",
  "short_name": "Semantic Field",
  "description": "A browser-based field for mapping words, concepts, relationships, and changing meaning.",
  "start_url": "/semantic-field-extension/?source=pwa",
  "scope": "/semantic-field-extension/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0c0d0e",
  "theme_color": "#0c0d0e",
  "categories": ["education", "productivity", "utilities"],
  "icons": [
    {
      "src": "assets/semantic-field-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/semantic-field-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/semantic-field-app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "assets/semantic-field-icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/semantic-field-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
